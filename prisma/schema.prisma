generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum Provider {
  IUNGO
  CHIP_FISICO
  META_CLOUD
  EVOLUTION
  ZAPI
}

enum HealthStatus {
  GREEN
  YELLOW
  RED
  BANNED
  LOST
  UNKNOWN
}

enum CheckSource {
  MANUAL
  API
}

enum AlertChannelKind {
  WHATSAPP
  EMAIL
  WEBHOOK
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships         Membership[]
  phoneNumbers        PhoneNumber[]
  providerCredentials ProviderCredential[]
  invites             Invite[]
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role      @default(VIEWER)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  notifyEnabled Boolean  @default(false)
  notifyEmail   String?
  createdAt     DateTime @default(now())

  memberships  Membership[]
  healthChecks HealthCheck[] @relation("HealthCheckCreatedBy")
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role   @default(VIEWER)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model PhoneNumber {
  id            String       @id @default(cuid())
  orgId         String
  label         String
  e164          String
  provider      Provider
  externalId    String?
  tier          String?
  currentStatus HealthStatus @default(UNKNOWN)
  currentScore  Int          @default(0)
  lastCheckAt   DateTime?
  notes         String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  healthChecks HealthCheck[]
  incidents    Incident[]
  alertLogs    AlertLog[]

  @@unique([orgId, e164])
  @@index([orgId, currentStatus])
}

model HealthCheck {
  id             String      @id @default(cuid())
  phoneNumberId  String
  status         HealthStatus
  score          Int
  source         CheckSource @default(MANUAL)
  messagingLimit String?
  observation    String?
  createdById    String?
  createdAt      DateTime    @default(now())

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("HealthCheckCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([phoneNumberId, createdAt])
}

model Incident {
  id            String        @id @default(cuid())
  phoneNumberId String
  fromStatus    HealthStatus
  toStatus      HealthStatus
  openedAt      DateTime      @default(now())
  resolvedAt    DateTime?

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId, resolvedAt])
}

/// Canais de notificação globais (não são mais por empresa): valem pra
/// qualquer alerta disparado em qualquer empresa da plataforma.
model AlertChannel {
  id      String           @id @default(cuid())
  kind    AlertChannelKind
  config  Json
  enabled Boolean          @default(true)

  alertLogs AlertLog[]
}

model AlertLog {
  id            String   @id @default(cuid())
  /// Empresa dona do número no momento do disparo — só histórico, não
  /// isola mais nada (Notificações é global).
  orgIdAtDispatch String?
  phoneNumberId String
  /// Nulo quando o disparo foi um e-mail pessoal (opt-in de usuário), não
  /// um AlertChannel global.
  channelId     String?
  /// Preenchido só nos disparos pessoais — quem recebeu.
  notifiedUserId String?
  payload       Json
  ok            Boolean
  error         String?
  createdAt     DateTime @default(now())

  phoneNumber PhoneNumber   @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  channel     AlertChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ProviderCredential {
  id        String   @id @default(cuid())
  orgId     String
  provider  Provider
  config    Json
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}
