generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

/// Como o número foi adquirido. Diferente de NumberPlatform (onde ele roda) —
/// ver comentário em PhoneNumber.origin.
enum NumberOrigin {
  CHIP_FISICO
  META_OFICIAL
  NUMERO_VIRTUAL
  IUNGO
}

/// Em quais plataformas o número está vinculado pra operar. Um número pode
/// ter mais de uma (ex: chip no WhatsApp Business *e* vinculado ao Z-API).
/// ONETY é sistema interno, não provedor: marca que o número é usado no CF
/// Onety, sem integração nem sincronização.
enum NumberPlatform {
  WHATSAPP_NORMAL
  WHATSAPP_BUSINESS
  ZAPI
  EVOLUTION
  META_CLOUD
  ONETY
}

/// Operadora do chip físico — só relevante pra origem CHIP_FISICO.
enum Carrier {
  TIM
  VIVO
  CLARO
  OI
  OUTRA
  DESCONHECIDA
}

/// Plano do chip físico — só relevante pra origem CHIP_FISICO. Pré-pago
/// recarrega (ver campos de recarga em PhoneNumber); conta/plano é faturado
/// e não usa esses campos.
enum ChipPlan {
  PRE_PAGO
  POS_PAGO
}

enum HealthStatus {
  GREEN
  YELLOW
  RED
  BANNED
  LOST
  UNKNOWN
}

enum CheckSource {
  MANUAL
  API
}

/// Classificação de qualidade da Graph API da Meta (quality_rating) — conceito
/// separado do HealthStatus: um número pode estar CONNECTED (status
/// operacional) com qualidade RED (risco de restrição). UNKNOWN é o padrão
/// pra número recém-vinculado, antes da primeira sincronização.
enum MetaQualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum AlertChannelKind {
  WHATSAPP
  EMAIL
  WEBHOOK
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships         Membership[]
  phoneNumbers        PhoneNumber[]
  providerCredentials ProviderCredential[]
  invites             Invite[]
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role      @default(VIEWER)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  notifyEnabled Boolean  @default(false)
  notifyEmail   String?
  createdAt     DateTime @default(now())

  memberships  Membership[]
  healthChecks HealthCheck[] @relation("HealthCheckCreatedBy")
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role   @default(VIEWER)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model PhoneNumber {
  id            String       @id @default(cuid())
  orgId         String
  label         String
  e164          String
  /// Como o número foi adquirido: chip físico, número oficial Meta, número
  /// virtual genérico, ou já pronto na Iungo (essa não tem vínculo — vem
  /// operacional).
  origin        NumberOrigin
  /// Em quais plataformas o número está vinculado pra operar de fato — vazio
  /// pra origem IUNGO (não se aplica) ou pra número ainda sem vínculo.
  platforms     NumberPlatform[]
  externalId    String?
  /// Token/segredo da instância no provedor (ex: TOKEN da instância Z-API,
  /// usado junto com externalId na URL da API). Não é a credencial da conta
  /// (essa fica em ProviderCredential) — é por número. Pra Meta Cloud API,
  /// externalId guarda o phone_number_id da Graph API e providerToken fica
  /// vazio — a autenticação é só a nível de WABA (ver ProviderCredential).
  providerToken String?
  /// messaging_limit_tier da Meta (ex: TIER_1K) — quantas conversas
  /// business-initiated o número pode abrir por dia. Só preenchido pra
  /// números com vínculo META_CLOUD.
  tier          String?
  /// quality_rating da Graph API — separado de currentStatus porque um
  /// número pode estar conectado (status operacional) com qualidade em
  /// queda (risco de ser restrito). Só relevante pra vínculo META_CLOUD.
  qualityRating MetaQualityRating?
  /// Gasto do mês corrente por número, via pricing_analytics da Graph API —
  /// null se a conta usa linha de crédito de Solution Partner/BSP (aí a API
  /// só devolve volume, sem custo). spendMonth ("2026-09") evita misturar
  /// valor de um mês com o próximo antes da sincronização seguinte.
  monthlySpend  Decimal? @db.Decimal(10, 2)
  spendCurrency String?
  spendMonth    String?
  currentStatus HealthStatus @default(UNKNOWN)
  currentScore  Int          @default(0)
  lastCheckAt   DateTime?
  /// Vencimento e status de pagamento da assinatura no provedor. Sem
  /// endpoint pra isso nas contas Z-API "Cliente" — preenchido manualmente
  /// (cache, não histórico). Nulo pra provedores/números sem esse dado.
  providerDueAt         DateTime?
  providerPaymentStatus String?
  /// Quando esse número foi verificado no provedor (Z-API ou Meta Cloud API)
  /// pela última vez, mesmo sem mudança de status — diferente de
  /// lastCheckAt, que só muda quando o status muda de fato. Usado pra não
  /// marcar como "sem dados" um número estável que continua sendo
  /// sincronizado normalmente.
  lastSyncAt DateTime?
  /// Recarga de crédito do chip físico — sem crédito a cada ~3 meses, a
  /// operadora recolhe o número. Só relevante pra origem CHIP_FISICO e
  /// chipPlan PRE_PAGO (conta/plano é faturado, não recarrega).
  chipPlan       ChipPlan?
  carrier        Carrier?
  lastRechargeAt DateTime?
  nextRechargeAt DateTime?
  /// Debounce do lembrete de recarga: null até disparar, resetado sempre
  /// que nextRechargeAt muda (edição manual ou botão "Recarregar") — evita
  /// alertar todo dia enquanto a recarga estiver perto do vencimento.
  rechargeReminderSentAt DateTime?
  notes         String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  healthChecks HealthCheck[]
  incidents    Incident[]
  alertLogs    AlertLog[]

  @@unique([orgId, e164])
  @@index([orgId, currentStatus])
}

model HealthCheck {
  id             String      @id @default(cuid())
  phoneNumberId  String
  status         HealthStatus
  score          Int
  source         CheckSource @default(MANUAL)
  messagingLimit String?
  observation    String?
  createdById    String?
  createdAt      DateTime    @default(now())

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("HealthCheckCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([phoneNumberId, createdAt])
}

model Incident {
  id            String        @id @default(cuid())
  phoneNumberId String
  fromStatus    HealthStatus
  toStatus      HealthStatus
  openedAt      DateTime      @default(now())
  resolvedAt    DateTime?

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId, resolvedAt])
}

/// Canais de notificação globais (não são mais por empresa): valem pra
/// qualquer alerta disparado em qualquer empresa da plataforma.
model AlertChannel {
  id      String           @id @default(cuid())
  kind    AlertChannelKind
  config  Json
  enabled Boolean          @default(true)

  alertLogs AlertLog[]
}

model AlertLog {
  id            String   @id @default(cuid())
  /// Empresa dona do número no momento do disparo — só histórico, não
  /// isola mais nada (Notificações é global).
  orgIdAtDispatch String?
  phoneNumberId String
  /// Nulo quando o disparo foi um e-mail pessoal (opt-in de usuário), não
  /// um AlertChannel global.
  channelId     String?
  /// Preenchido só nos disparos pessoais — quem recebeu.
  notifiedUserId String?
  payload       Json
  ok            Boolean
  error         String?
  createdAt     DateTime @default(now())

  phoneNumber PhoneNumber   @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  channel     AlertChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ProviderCredential {
  id        String         @id @default(cuid())
  orgId     String
  platform  NumberPlatform
  config    Json
  createdAt DateTime       @default(now())
  /// Quando a sincronização dessa credencial rodou pela última vez (manual
  /// ou pelo worker), independente de ter dado certo ou não.
  lastSyncAt DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, platform])
}
