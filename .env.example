# Copie para .env e preencha. Em produção (EasyPanel), configure estas
# mesmas variáveis no serviço.

DATABASE_URL="postgresql://user:password@host:5432/controle_numeros?schema=public"

NEXTAUTH_URL="https://numeros.seudominio.com"
NEXTAUTH_SECRET="gere com: openssl rand -hex 32"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Controle de Numeros <no-reply@seudominio.com>"

# Assina o payload enviado aos webhooks (ex: n8n) no header X-Signature.
WEBHOOK_SIGNING_SECRET="gere com: openssl rand -hex 32"

# Usados só pelo prisma/seed.ts, opcional.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
